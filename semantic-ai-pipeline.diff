diff --git a/core/ai/intentPlanLlm.mjs b/core/ai/intentPlanLlm.mjs
new file mode 100644
index 0000000..d6f5880
--- /dev/null
+++ b/core/ai/intentPlanLlm.mjs
@@ -0,0 +1,121 @@
+/**
+ * LLM streaming helpers: partial Bot Intent Plan → compiled Bot IR snapshot.
+ * AI must never emit stacks, React Flow nodes, or raw Canonical IR.
+ */
+
+import { normalizeAiCanonicalIr } from './aiCanonicalIr.mjs';
+import {
+  BOT_INTENT_PLAN_VERSION,
+  extractBotIntentPlanFromRaw,
+} from './botIntentPlan.mjs';
+import { compileIntentPlanToBotIr } from './intentToBotIr.mjs';
+
+function parseJsonMaybe(text) {
+  if (!text) return null;
+  try {
+    return JSON.parse(text);
+  } catch {
+    return null;
+  }
+}
+
+function completePartialJsonObject(raw) {
+  const source = String(raw || '').trim();
+  if (!source || source[0] !== '{') return null;
+  let out = source;
+  const stack = [];
+  let inString = false;
+  let escaped = false;
+  for (let i = 0; i < source.length; i += 1) {
+    const ch = source[i];
+    if (escaped) {
+      escaped = false;
+      continue;
+    }
+    if (ch === '\\' && inString) {
+      escaped = true;
+      continue;
+    }
+    if (ch === '"') {
+      inString = !inString;
+      continue;
+    }
+    if (inString) continue;
+    if (ch === '{') stack.push('}');
+    else if (ch === '[') stack.push(']');
+    else if ((ch === '}' || ch === ']') && stack[stack.length - 1] === ch) stack.pop();
+    if (stack.length === 0 && out.trim().endsWith('}')) break;
+  }
+  if (!out.trim()) return null;
+  if (escaped) out = out.slice(0, -1);
+  if (inString) out += '"';
+  out = out.replace(/,\s*$/g, '');
+  while (stack.length > 0) {
+    const closer = stack.pop();
+    out = out.replace(/,\s*$/g, '');
+    out += closer;
+  }
+  return out;
+}
+
+function unwrapIntentPlanPayload(value) {
+  if (!value || typeof value !== 'object' || Array.isArray(value)) return null;
+  if (Number(value.intentPlanVersion) === BOT_INTENT_PLAN_VERSION) return value;
+  if (value.botIntentPlan && typeof value.botIntentPlan === 'object') {
+    return unwrapIntentPlanPayload(value.botIntentPlan);
+  }
+  if (value.intentPlan && typeof value.intentPlan === 'object') {
+    return unwrapIntentPlanPayload(value.intentPlan);
+  }
+  if (value.plan && typeof value.plan === 'object') {
+    return unwrapIntentPlanPayload(value.plan);
+  }
+  return null;
+}
+
+/**
+ * Compile partial/full LLM text to Bot IR only when it contains Bot Intent Plan JSON.
+ * Rejects legacy stacks and Canonical IR emitted directly by the model.
+ */
+export function extractPartialBotIrFromLlmStream(raw, deterministicPlan = null) {
+  const intentExtracted = extractBotIntentPlanFromRaw(raw);
+  if (intentExtracted?.plan) {
+    try {
+      return normalizeAiCanonicalIr(compileIntentPlanToBotIr(intentExtracted.plan, deterministicPlan));
+    } catch {
+      return null;
+    }
+  }
+
+  const completed = completePartialJsonObject(raw);
+  const parsed = parseJsonMaybe(completed);
+  if (!parsed || typeof parsed !== 'object') return null;
+
+  const unwrapped = unwrapIntentPlanPayload(
+    parsed.botIntentPlan || parsed.intentPlan || parsed.plan || parsed,
+  );
+  if (!unwrapped) return null;
+
+  try {
+    return normalizeAiCanonicalIr(compileIntentPlanToBotIr(unwrapped, deterministicPlan));
+  } catch {
+    return null;
+  }
+}
+
+export function buildIntentPlanLlmMessages({
+  systemPrompt,
+  coreAppendix,
+  intentPlanContext,
+  astPolicyAppendix,
+  userPrompt,
+  fewShots = [],
+}) {
+  const messages = [{ role: 'system', content: systemPrompt + coreAppendix + intentPlanContext + astPolicyAppendix }];
+  for (const shot of fewShots) {
+    messages.push({ role: 'user', content: shot.user });
+    messages.push({ role: 'assistant', content: shot.assistant });
+  }
+  messages.push({ role: 'user', content: userPrompt });
+  return messages;
+}
diff --git a/core/ai/intentToBotIr.mjs b/core/ai/intentToBotIr.mjs
new file mode 100644
index 0000000..3899b45
--- /dev/null
+++ b/core/ai/intentToBotIr.mjs
@@ -0,0 +1,313 @@
+/**
+ * Planner: Bot Intent Plan → Canonical AI IR (Bot IR for AI pipeline).
+ */
+
+import { AI_TARGET_CORE_EXACT, normalizeAiCanonicalIr } from './aiCanonicalIr.mjs';
+import { normalizeBotIntentPlan } from './botIntentPlan.mjs';
+import { SEMANTIC_TEMPLATE_IDS, buildSemanticTemplateIr } from './intentPlanner.mjs';
+
+function asArray(value) {
+  return Array.isArray(value) ? value : [];
+}
+
+function isObject(value) {
+  return Boolean(value && typeof value === 'object' && !Array.isArray(value));
+}
+
+function str(value, fallback = '') {
+  return typeof value === 'string' ? value.trim() : fallback;
+}
+
+function slug(raw, fallback) {
+  const cleaned = str(raw)
+    .toLowerCase()
+    .replace(/ё/g, 'е')
+    .replace(/[^a-zа-я0-9_]+/giu, '_')
+    .replace(/_+/g, '_')
+    .replace(/^_+|_+$/g, '');
+  return cleaned || fallback;
+}
+
+let handlerSeq = 0;
+let scenarioSeq = 0;
+
+function nextHandlerId(prefix = 'h') {
+  handlerSeq += 1;
+  return `${prefix}_${handlerSeq}`;
+}
+
+function nextScenarioId(name) {
+  scenarioSeq += 1;
+  return `sc_${slug(name, `scenario_${scenarioSeq}`)}`;
+}
+
+function resetIds() {
+  handlerSeq = 0;
+  scenarioSeq = 0;
+}
+
+function flowStepToActions(step, ctx) {
+  if (!isObject(step)) return [];
+  const kind = str(step.kind);
+  if (kind === 'show_screen') {
+    const screenId = str(step.screenId, 'ui_start');
+    return [{ type: 'ui_state', uiStateId: screenId }, { type: 'stop' }];
+  }
+  if (kind === 'ask') {
+    return [{ type: 'ask', question: str(step.question, 'Введите значение:'), varname: slug(step.field, 'value') }];
+  }
+  if (kind === 'message') {
+    return [{ type: 'message', text: str(step.text, '...') }];
+  }
+  if (kind === 'remember') {
+    return [{ type: 'remember', varname: slug(step.field, 'var'), value: str(step.value, '{text}') }];
+  }
+  if (kind === 'get') {
+    return [{ type: 'get', key: str(step.key), varname: slug(step.field, 'value') }];
+  }
+  if (kind === 'save') {
+    return [{ type: 'save', key: str(step.key), value: str(step.value) }];
+  }
+  if (kind === 'save_global') {
+    return [{ type: 'save_global', key: str(step.key), value: str(step.value) }];
+  }
+  if (kind === 'send_file') {
+    return [{ type: 'send_file', file: `{${slug(step.field, 'file')}}` }];
+  }
+  if (kind === 'condition') {
+    return [{
+      type: 'condition',
+      cond: str(step.expression, 'true'),
+      then: asArray(step.ifTrue).flatMap((s) => flowStepToActions(s, ctx)),
+      ...(asArray(step.ifFalse).length ? { else: asArray(step.ifFalse).flatMap((s) => flowStepToActions(s, ctx)) } : {}),
+    }];
+  }
+  if (kind === 'end') return [{ type: 'stop' }];
+  if (kind === 'run_flow') {
+    const targetFlow = ctx.flowById.get(str(step.flowId));
+    if (targetFlow) return [{ type: 'run_scenario', target: slug(targetFlow.name, targetFlow.id) }];
+  }
+  return [];
+}
+
+function buildUiStates(screens) {
+  return asArray(screens).map((screen, index) => {
+    const buttons = asArray(screen.buttons).join(', ');
+    const state = {
+      id: str(screen.id, `ui_${index + 1}`),
+      message: str(screen.message),
+      ...(buttons ? { buttons } : {}),
+    };
+    if (isObject(screen.inlineCatalog) && str(screen.inlineCatalog.key)) {
+      state.inlineDb = {
+        key: str(screen.inlineCatalog.key),
+        callbackPrefix: str(screen.inlineCatalog.callbackPrefix, 'item:'),
+        backText: str(screen.inlineCatalog.backText, 'Назад'),
+        backCallback: str(screen.inlineCatalog.backCallback, 'back'),
+        columns: String(screen.inlineCatalog.columns || '1'),
+      };
+    }
+    return state;
+  });
+}
+
+function flowToScenario(flow, ctx = { flowById: new Map() }) {
+  const steps = [];
+  let stepBuffer = [];
+  let stepIndex = 0;
+
+  const flushStep = (name) => {
+    if (!stepBuffer.length) return;
+    steps.push({
+      id: `step_${slug(name, String(stepIndex + 1))}`,
+      name: slug(name, `шаг_${stepIndex + 1}`),
+      actions: [...stepBuffer],
+    });
+    stepBuffer = [];
+    stepIndex += 1;
+  };
+
+  for (const step of asArray(flow.steps)) {
+    const kind = str(step.kind);
+    if (kind === 'ask') {
+      flushStep(step.field || `step_${stepIndex}`);
+      stepBuffer.push(...flowStepToActions(step, ctx));
+      flushStep(step.field || `step_${stepIndex}`);
+      continue;
+    }
+    if (kind === 'end') {
+      stepBuffer.push(...flowStepToActions(step, ctx));
+      flushStep(`final_${stepIndex}`);
+      continue;
+    }
+    stepBuffer.push(...flowStepToActions(step, ctx));
+  }
+  if (stepBuffer.length) flushStep(`final_${stepIndex}`);
+
+  if (!steps.length) {
+    const fallbackActions = asArray(flow.steps).flatMap((s) => flowStepToActions(s, ctx));
+    if (fallbackActions.length) {
+      steps.push({ id: 'step_1', name: 'main', actions: fallbackActions });
+    }
+  }
+
+  return {
+    id: nextScenarioId(flow.name),
+    name: slug(flow.name, flow.id),
+    steps,
+  };
+}
+
+/**
+ * @param {import('./botIntentPlan.mjs').normalizeBotIntentPlan extends Function ? ReturnType<typeof normalizeBotIntentPlan> : object} botIntentPlan
+ * @param {object} [deterministicPlan]
+ */
+export function compileIntentPlanToBotIr(botIntentPlan, deterministicPlan = {}) {
+  resetIds();
+  const plan = normalizeBotIntentPlan(botIntentPlan);
+  const templateHint = str(plan.templateHint || deterministicPlan?.knownCapabilityTemplate);
+  if (
+    templateHint &&
+    Object.values(SEMANTIC_TEMPLATE_IDS).includes(templateHint) &&
+    !asArray(plan.flows).length
+  ) {
+    return buildSemanticTemplateIr(
+      { ...deterministicPlan, knownCapabilityTemplate: templateHint },
+      { prompt: plan.summary },
+    );
+  }
+
+  const flowById = new Map(asArray(plan.flows).map((f) => [str(f.id), f]));
+  const uiStates = buildUiStates(plan.screens);
+  const handlers = [];
+  const scenarios = [];
+  const transitions = [];
+
+  if (!uiStates.length && asArray(plan.flows).some((f) => f.trigger?.type === 'start')) {
+    uiStates.push({
+      id: 'ui_start',
+      message: str(plan.summary, 'Добро пожаловать!'),
+      buttons: asArray(plan.menuButtons).map((b) => b.label).join(', '),
+    });
+  }
+
+  const startFlow = asArray(plan.flows).find((f) => f.trigger?.type === 'start') || plan.flows[0];
+  if (startFlow) {
+    const startScreen = asArray(startFlow.steps).find((s) => s.kind === 'show_screen');
+    const startActions = [];
+    if (startScreen) {
+      startActions.push({ type: 'ui_state', uiStateId: str(startScreen.screenId, 'ui_start') });
+    } else if (uiStates.length) {
+      startActions.push({ type: 'ui_state', uiStateId: uiStates[0].id });
+    } else {
+      startActions.push({ type: 'message', text: str(plan.summary, 'Привет!') });
+    }
+    const hasScenario = asArray(startFlow.steps).some((s) => ['ask', 'run_flow'].includes(s.kind));
+    if (hasScenario && asArray(startFlow.steps).some((s) => s.kind === 'ask')) {
+      const scenario = flowToScenario(startFlow, { flowById });
+      scenarios.push(scenario);
+      startActions.push({ type: 'run_scenario', target: scenario.name });
+    } else {
+      startActions.push(...asArray(startFlow.steps).flatMap((s) => flowStepToActions(s, { flowById })));
+    }
+    if (!startActions.some((a) => a.type === 'stop')) startActions.push({ type: 'stop' });
+    handlers.push({ id: nextHandlerId('start'), type: 'start', trigger: '', actions: startActions });
+  }
+
+  for (const menuBtn of asArray(plan.menuButtons)) {
+    const flow = flowById.get(str(menuBtn.flowId));
+    if (!flow) continue;
+    const scenario = flowToScenario(flow, { flowById });
+    scenarios.push(scenario);
+    handlers.push({
+      id: nextHandlerId('cb'),
+      type: 'callback',
+      trigger: str(menuBtn.label),
+      actions: [
+        { type: 'message', text: `Запуск: ${flow.name}` },
+        { type: 'run_scenario', target: scenario.name },
+      ],
+    });
+    transitions.push({ from: handlers[handlers.length - 1].id, to: scenario.id, type: 'run_scenario' });
+  }
+
+  for (const flow of asArray(plan.flows)) {
+    const trigger = flow.trigger || {};
+    if (trigger.type === 'start') continue;
+    if (trigger.type === 'button' || trigger.type === 'callback') {
+      const scenario = flowToScenario(flow, { flowById });
+      const existing = scenarios.find((s) => s.name === scenario.name);
+      if (!existing) scenarios.push(scenario);
+      const scenarioName = existing?.name || scenario.name;
+      handlers.push({
+        id: nextHandlerId('cb'),
+        type: 'callback',
+        trigger: str(trigger.value),
+        actions: [{ type: 'run_scenario', target: scenarioName }],
+      });
+      transitions.push({
+        from: handlers[handlers.length - 1].id,
+        to: existing?.id || scenario.id,
+        type: 'run_scenario',
+      });
+      continue;
+    }
+    if (trigger.type === 'command') {
+      handlers.push({
+        id: nextHandlerId('cmd'),
+        type: 'command',
+        trigger: str(trigger.value).replace(/^\/+/, '') || 'help',
+        actions: asArray(flow.steps).flatMap((s) => flowStepToActions(s, { flowById })),
+      });
+      continue;
+    }
+    if (trigger.type === 'text') {
+      const scenario = flowToScenario(flow, { flowById });
+      scenarios.push(scenario);
+      handlers.push({
+        id: nextHandlerId('text'),
+        type: 'text',
+        trigger: '',
+        actions: [{ type: 'run_scenario', target: scenario.name }],
+      });
+    }
+  }
+
+  if (!handlers.some((h) => h.type === 'start')) {
+    handlers.unshift({
+      id: nextHandlerId('start'),
+      type: 'start',
+      trigger: '',
+      actions: [
+        { type: 'message', text: str(plan.summary, 'Привет!') },
+        { type: 'stop' },
+      ],
+    });
+  }
+
+  const ir = normalizeAiCanonicalIr({
+    irVersion: 1,
+    targetCore: AI_TARGET_CORE_EXACT,
+    compatibilityMode: `${AI_TARGET_CORE_EXACT} exact`,
+    intent: {
+      primary: str(plan.primaryGoal, plan.summary),
+      botType: str(plan.botType || deterministicPlan?.botType),
+      semanticTemplate: templateHint || deterministicPlan?.knownCapabilityTemplate,
+      plannedFrom: 'bot_intent_plan',
+    },
+    state: {
+      globals: asArray(plan.globals).map((g) => ({ name: g.name, value: g.value })),
+    },
+    handlers,
+    blocks: [],
+    scenarios,
+    transitions,
+    uiStates,
+    meta: {
+      compiledFrom: 'bot_intent_plan',
+      intentPlanVersion: plan.intentPlanVersion,
+    },
+  });
+
+  return ir;
+}
diff --git a/core/ai/irRepairEngine.mjs b/core/ai/irRepairEngine.mjs
index ab57210..7e9615a 100644
--- a/core/ai/irRepairEngine.mjs
+++ b/core/ai/irRepairEngine.mjs
@@ -1,9 +1,11 @@
+import { normalizeAiCanonicalIr } from './aiCanonicalIr.mjs';
+import { reconcileIrGraph } from './graphReconciler.mjs';
 import {
   canonicalSymbolFor,
   IR_USER_STORAGE_KEYS,
   isForbiddenInventedSymbol,
 } from './irSymbolRegistry.mjs';
-import { IR_ERROR_CODES } from './irSemanticGate.mjs';
+import { IR_ERROR_CODES, validateIrSemanticGate } from './irSemanticGate.mjs';
 
 function asArray(value) {
   return Array.isArray(value) ? value : [];
@@ -372,3 +374,54 @@ export function repairIrDeterministic(ir, diagnostics = [], options = {}) {
     notes,
   };
 }
+
+/**
+ * Reconcile + semantic gate + deterministic repair (used by semantic AI pipeline).
+ */
+export function runDeterministicIrRepairLoop(ir, options = {}) {
+  const maxRepairPasses = Math.max(0, Number(options.maxRepairPasses ?? 2) || 0);
+  let current = normalizeAiCanonicalIr(ir);
+  const repairNotes = [];
+  const graphDiagnostics = [];
+
+  for (let repairPass = 0; repairPass <= maxRepairPasses; repairPass += 1) {
+    const reconciliation = reconcileIrGraph(current, options);
+    current = normalizeAiCanonicalIr(reconciliation.ir);
+    if (reconciliation.changed || reconciliation.diagnostics?.length) {
+      graphDiagnostics.push(...asArray(reconciliation.diagnostics));
+      repairNotes.push(...asArray(reconciliation.notes).map((note) => `pass ${repairPass}: GRAPH_RECONCILER: ${note}`));
+    }
+
+    const validation = validateIrSemanticGate(current, options);
+    const mergedValidation = {
+      ...validation,
+      diagnostics: [...graphDiagnostics, ...asArray(validation.diagnostics)],
+    };
+    if (validation.ok) {
+      return { ok: true, ir: current, validation: mergedValidation, repairNotes };
+    }
+    if (repairPass === maxRepairPasses) {
+      return { ok: false, ir: current, validation: mergedValidation, repairNotes };
+    }
+
+    const repaired = repairIrDeterministic(current, validation.diagnostics, options);
+    repairNotes.push(...asArray(repaired.notes).map((note) => `pass ${repairPass + 1}: ${note}`));
+    current = normalizeAiCanonicalIr(repaired.ir);
+    if (!repaired.changed) {
+      return { ok: false, ir: current, validation: mergedValidation, repairNotes };
+    }
+  }
+
+  const reconciliation = reconcileIrGraph(current, options);
+  current = normalizeAiCanonicalIr(reconciliation.ir);
+  const validation = validateIrSemanticGate(current, options);
+  return {
+    ok: validation.ok,
+    ir: current,
+    validation: {
+      ...validation,
+      diagnostics: [...graphDiagnostics, ...asArray(validation.diagnostics)],
+    },
+    repairNotes,
+  };
+}
diff --git a/core/ai/semanticAiPipeline.mjs b/core/ai/semanticAiPipeline.mjs
new file mode 100644
index 0000000..13b02fb
--- /dev/null
+++ b/core/ai/semanticAiPipeline.mjs
@@ -0,0 +1,170 @@
+/**
+ * Semantic AI planning pipeline:
+ *   1. AI → Bot Intent Plan (semantic JSON only; no graph nodes)
+ *   2. Planner → Bot IR (Canonical AI IR)
+ *   3. Compiler → executable editor stacks (validated; never raw React Flow)
+ *   Template path: deterministic IntentPlan → template IR → Compiler
+ */
+
+/** @typedef {'SEMANTIC_AI' | 'TEMPLATE'} SemanticPipelineId */
+
+/**
+ * Full semantic planning: Bot Intent Plan → Bot IR → stacks.
+ * @param {object} botIntentPlan
+ * @param {object} deterministicPlan
+ * @param {object} [options]
+ * @returns {Promise<{ ok: boolean, canonicalIr: object|null, stacks: object[]|null, diagnostics: object[], repairActions: string[], errors: string[], pipeline: SemanticPipelineId }>}
+ */
+export function runSemanticPlanningPipeline(botIntentPlan, deterministicPlan, options = {}) {
+  return runSemanticAiPipeline(botIntentPlan, deterministicPlan, options);
+}
+import { applyIntentBudgetToIr, buildSemanticTemplateIr } from './intentPlanner.mjs';
+import { normalizeBotIntentPlan, validateBotIntentPlan } from './botIntentPlan.mjs';
+import { compileIntentPlanToBotIr } from './intentToBotIr.mjs';
+import { compileBotIrToExecutableGraph } from './graphCompiler.mjs';
+import { resolveFeatureDependencies } from './featureDependencyResolver.mjs';
+import { repairIntentSatisfaction } from './intentSatisfactionValidator.mjs';
+import { runDeterministicIrRepairLoop } from './irRepairEngine.mjs';
+
+function asArray(value) {
+  return Array.isArray(value) ? value : [];
+}
+
+/**
+ * Template-based generation: deterministic IntentPlan → IR → executable graph.
+ */
+export function runTemplateGraphPipeline(intentPlan, options = {}) {
+  const templateIr = buildSemanticTemplateIr(intentPlan, { prompt: options.prompt });
+  const budgeted = applyIntentBudgetToIr(templateIr, intentPlan);
+  let ir = budgeted.ir;
+  const diagnostics = [];
+  const repairActions = [];
+
+  if (budgeted.changed) {
+    repairActions.push(...budgeted.notes.map((n) => `INTENT_BUDGET: ${n}`));
+  }
+
+  const featureResolution = resolveFeatureDependencies(ir, {
+    intentPlan,
+    astMode: options.astMode,
+    allowedMemoryKeys: options.allowedMemoryKeys,
+  });
+  ir = featureResolution.ir;
+  diagnostics.push(...asArray(featureResolution.diagnostics));
+  repairActions.push(...asArray(featureResolution.repairActions).map((a) => `FDR: ${a}`));
+
+  const compiled = compileBotIrToExecutableGraph(ir, options);
+  return {
+    ok: compiled.ok,
+    canonicalIr: compiled.ir,
+    stacks: compiled.stacks,
+    diagnostics: [...diagnostics, ...asArray(compiled.diagnostics)],
+    repairActions,
+    errors: compiled.errors,
+    pipeline: 'TEMPLATE',
+  };
+}
+
+/**
+ * AI semantic path: Bot Intent Plan → Bot IR → executable graph.
+ */
+export function runSemanticAiPipeline(botIntentPlan, deterministicPlan, options = {}) {
+  const normalizedPlan = normalizeBotIntentPlan(botIntentPlan);
+  const validation = validateBotIntentPlan(normalizedPlan);
+  const diagnostics = [...asArray(validation.warnings).map((message) => ({
+    code: 'INTENT_PLAN_WARNING',
+    severity: 'warning',
+    message,
+  }))];
+  const repairActions = [];
+
+  if (!validation.ok) {
+    return {
+      ok: false,
+      canonicalIr: null,
+      stacks: null,
+      diagnostics: [
+        ...diagnostics,
+        ...validation.errors.map((message) => ({
+          code: 'INTENT_PLAN_INVALID',
+          severity: 'error',
+          message,
+        })),
+      ],
+      repairActions,
+      errors: validation.errors,
+      pipeline: 'SEMANTIC_AI',
+    };
+  }
+
+  diagnostics.push({
+    code: 'INTENT_PLAN_ACCEPTED',
+    severity: 'info',
+    message: `Bot Intent Plan accepted: ${normalizedPlan.flows.length} flows, ${normalizedPlan.screens.length} screens.`,
+  });
+
+  let ir = compileIntentPlanToBotIr(normalizedPlan, deterministicPlan);
+
+  const budgeted = applyIntentBudgetToIr(ir, deterministicPlan);
+  ir = budgeted.ir;
+  if (budgeted.changed) {
+    repairActions.push(...budgeted.notes.map((n) => `INTENT_BUDGET: ${n}`));
+    diagnostics.push({
+      code: 'COMPLEXITY_REDUCED',
+      severity: 'info',
+      message: budgeted.notes.join('; ') || 'budget enforced',
+    });
+  }
+
+  const intentRepair = repairIntentSatisfaction(ir, {
+    prompt: options.prompt,
+    intentPlan: deterministicPlan,
+  });
+  if (intentRepair.changed) {
+    ir = applyIntentBudgetToIr(intentRepair.ir, deterministicPlan).ir;
+    diagnostics.push(...asArray(intentRepair.diagnostics));
+    repairActions.push(...asArray(intentRepair.repairNotes));
+  }
+
+  const featureResolution = resolveFeatureDependencies(ir, {
+    intentPlan: deterministicPlan,
+    astMode: options.astMode,
+    allowedMemoryKeys: options.allowedMemoryKeys,
+  });
+  ir = featureResolution.ir;
+  diagnostics.push(...asArray(featureResolution.diagnostics));
+  repairActions.push(...asArray(featureResolution.repairActions).map((a) => `FDR: ${a}`));
+
+  const repaired = runDeterministicIrRepairLoop(ir, {
+    astMode: options.astMode,
+    allowedMemoryKeys: options.allowedMemoryKeys,
+    deadline: options.deadline,
+    maxRepairPasses: options.maxRepairPasses ?? 2,
+  });
+  ir = repaired.ir;
+  diagnostics.push(...asArray(repaired.validation?.diagnostics));
+  repairActions.push(...asArray(repaired.repairNotes));
+
+  if (!repaired.ok) {
+    return {
+      ok: false,
+      canonicalIr: ir,
+      stacks: null,
+      diagnostics,
+      repairActions,
+      errors: ['IR semantic repair failed after intent planning'],
+      pipeline: 'SEMANTIC_AI',
+    };
+  }
+
+  const compiled = compileBotIrToExecutableGraph(ir, options);
+  return {
+    ok: compiled.ok,
+    canonicalIr: compiled.ir,
+    stacks: compiled.stacks,
+    diagnostics: [...diagnostics, ...asArray(compiled.diagnostics)],
+    repairActions,
+    errors: compiled.errors,
+    pipeline: 'SEMANTIC_AI',
+  };
+}
