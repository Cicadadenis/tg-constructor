# Copy to env_cicada on the server (that file is gitignored; never commit real secrets).
# ─── Frontend (Vite) ─────────────────────────────────────────
# ESPHome Конструктор: URL в новой вкладке с лендинга (по умолчанию /esphome/ на сервере).
# Локально на Windows, например:
# VITE_ESPHOME_CONSTRUCTOR_URL=file:///C:/Users/denis/Downloads/esphome-constructor-main/index.html

# ─── Environment modes ─────────────────────────────────────────
# Local development (web browser + Vite hot reload):
#   NODE_ENV=development
#   AUTH_BYPASS=1          # mock user, no login required
#
# Production deployment:
#   NODE_ENV=production
#   AUTH_BYPASS must be unset or 0 — bypass is always ignored in production
#
# APP_ENV=production is a legacy alias for NODE_ENV=production (Docker/scripts).

# ─── Server ──────────────────────────────────────────────────
# Local dev example:
# NODE_ENV=development
# AUTH_BYPASS=1
#
# Production example:
NODE_ENV=production
APP_ENV=production
API_HOST=0.0.0.0
API_PORT=3001
PYTHON_BIN=python3
BOT_PYTHON_VENV=.venv-bot
# Опциональный checkout cicada-studio. Если пусто, Studio использует установленный пакет cicada-studio.
# Пример Windows: CICADA_TG_ROOT=C:\\Users\\me\\projects\\cicada-studio
# CICADA_TG_ROOT=
# PYTHON=C:\Python312\python.exe

# Google OAuth (email / account linking)
GOOGLE_CLIENT_ID=GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=GOOGLE_CLIENT_SECRET
GOOGLE_CALLBACK_URL=GOOGLE_CALLBACK_URL
APP_URL=https://example.com

# Rate limits (optional; defaults shown)
# GLOBAL_API_RATE_MAX=1200
# LOGIN_RATE_MAX=15
# BOT_LOGS_RATE_MAX=50
# BOT_POLL_RATE_MAX=150

# Browser origins allowed for credentialed CORS (comma-separated). In production without this var, only APP_URL is allowed (set APP_ENV=production).
# CORS_ORIGINS=https://example.com,https://www.example.com

OLLAMA_URL=https://api.example.com
OLLAMA_MODEL=your-model-name
GROQ_TOKEN=your_groq_token_1
GROQ_TOKEN_2=your_groq_token_2
GROQ_TOKEN_3=your_groq_token_3
DSL_MAX_RUNTIME_MS=300000
DSL_MAX_CODE_BYTES=100000
DSL_MAX_LOG_CHARS=80000
# auto использует bwrap/firejail при наличии; enforced запрещает запуск DSL без sandbox.
DSL_SANDBOX_MODE=enforced
# production default: none (no host network in sandbox). Set host for live Telegram/server bots.
DSL_SANDBOX_NETWORK=none
DSL_CPU_SECONDS=60
DSL_MEMORY_BYTES=536870912
DSL_MAX_PROCESSES=64
PREVIEW_MAX_CONCURRENT=8
PREVIEW_WATCHDOG_MS=90000
PREVIEW_WORKER_MAX_REQUESTS=500
PREVIEW_SANDBOX_NETWORK=none
AVATAR_JSON_LIMIT=7mb
PREVIEW_JSON_LIMIT=16mb
SUPPORT_JSON_LIMIT=8mb

# ─── Vite (фронт) ────────────────────────────────────────────
# UI dev server port (default 5173). Open exactly the URL printed by `npm run dev`.
VITE_DEV_PORT=5173
# Dev auth bypass — mirrored to VITE_AUTH_BYPASS by vite.config.js (development builds only)
# AUTH_BYPASS=1
# Set to false to let Vite pick the next free port (5174, 5175…) — not recommended.
# VITE_STRICT_PORT=false
VITE_API_URL=http://localhost:3001
VITE_API_TARGET=http://localhost:3001
VITE_ADMIN_EMAIL=admin@example.com
VITE_TG_BOT_NAME=your_bot_name

# Termux / LOCAL (WSL): вход без окна логина; админ из БД по ADMIN_EMAIL
# AUTH_BYPASS=1
# ADMIN_EMAIL=denisbednakov@gmail.com
# Termux / лёгкий LOCAL: отключить ESPHome и jammer при старте сервера
# DISABLE_FIRMWARE_RUNTIME=1

# ─── PostgreSQL ───────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=app_db
DB_USER=app_user
DB_PASSWORD=strong_password_here

# ─── Безопасность ────────────────────────────────────────────
ADMIN_KEY=disabled
# Корень поиска сборок ESPHome / PlatformIO (по умолчанию — cwd сервера)
# Ephemeral ESPHome compile jobs (isolated /tmp/esphome-jobs/{jobId}/)
# ESPHOME_JOBS_ROOT=/tmp/esphome-jobs
# ESPHOME_MAX_CONCURRENT_BUILDS=4
# FIRMWARE_DOWNLOAD_TTL_MS=3600000
# ESPHOME_CLEANUP_INTERVAL_MS=300000
# FIRMWARE_BUILD_TIMEOUT_MS=1800000
# ESPHOME_PLATFORMIO_HOME=/var/www/cicada-studio/.cache/platformio

# FIRMWARE_WORKSPACE_ROOT=/path/to/esphome-project
# FIRMWARE_PROJECT_DIR=/path/to/active/build
# FIRMWARE_CHIP_FAMILY=ESP32,ESP8266
# FIRMWARE_DEVICE_NAME=My ESP Device
# FIRMWARE_WATCH=0
# FIRMWARE_SESSION_TTL_MS=1800000
# FIRMWARE_BUILD_TIMEOUT_MS=1800000
# ESPHOME_PLATFORMIO_HOME=/var/www/cicada-studio/.cache/platformio
# ESPHOME_BIN=esphome
# На сервере: python3 -m venv .venv-esphome && .venv-esphome/bin/pip install esphome
# ESPHOME_BIN=/var/www/cicada-studio/.venv-esphome/bin/esphome
# PIO_BIN=pio
# Публичная сборка из /esphome (YAML без projectId). 0 — только для вошедших пользователей.
# ESP8266 Deauther (страница /flash/jammer/): путь к готовому .bin
# JAMMER_FIRMWARE_BIN=/var/www/cicada-studio/esp8266_deauther.bin

# Публичная сборка без входа отключена (только авторизованные пользователи Cicada Studio).
# ESPHOME_PUBLIC_BUILD=0
# В production (APP_ENV=production): обязателен стабильный JWT_SECRET >= 32 символов
JWT_SECRET=super_long_random_secret_key_please_change
JWT_EXPIRES_SEC=604800
# Срок admin cookie (stateless JWT admin_session), секунды. По умолчанию 28800 (8 ч)
# ADMIN_JWT_EXPIRES_SEC=28800
# Admin auth v2: JWT role=admin или admin_session; canary — заголовок X-Admin-V2: 1
# ADMIN_AUTH_V2=1
# Отпечатки админки хранятся в PostgreSQL (таблица admin_passkeys), не в JSON-файле
# ADMIN_PASSKEYS_FILE=/secure/path/admin-passkeys.json
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=App Name <noreply@example.com>

# ─── Telegram ─────────────────────────────────────────────────
# Виджет входа: TG_BOT_TOKEN и @username в VITE_TG_BOT_NAME — от ОДНОГО бота.
# В @BotFather для бота: /setdomain — домен сайта, где открыта страница входа (без https).
# Callback: {VITE_API_URL}/auth/telegram/callback (должен быть доступен с тем же доменом что и API).
TG_BOT_TOKEN=your_telegram_bot_token

# ─── CryptoBot ───────────────────────────────────────────────
CRYPTOBOT_TOKEN=your_cryptobot_token
