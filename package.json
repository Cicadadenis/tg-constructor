{
  "name": "cicada-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:full": "node scripts/dev-full.mjs",
    "build": "npm run core:guard && vite build && rm -f dist/debug.html dist/debug-ide-app.js",
    "start": "cross-env NODE_ENV=production node --import tsx server.mjs",
    "server": "node --import tsx server.mjs",
    "server:dev": "cross-env NODE_ENV=development node --import tsx server.mjs",
    "preview": "vite preview",
    "check:server": "node --check server.mjs",
    "docker:nuke": "bash scripts/docker-nuke.sh",
    "ci:codegen": "node scripts/core-blocks-check.mjs",
    "core:guard": "node scripts/core-guard.mjs",
    "lint": "eslint src core/tests services scripts server.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test:compiler": "tsx tests/compiler/compiler.test.ts",
    "test:bot-ir": "tsx tests/compiler/bot_ir.test.ts",
    "test:block-capabilities": "node --test core/tests/block-capabilities.test.mjs",
    "test:fsm-graph": "tsx tests/compiler/fsmGraph.test.ts",
    "test:visual-db": "tsx tests/compiler/visual_db.test.ts",
    "test:foreach": "tsx tests/compiler/foreach.test.ts",
    "test:runtime-context": "tsx tests/compiler/runtime_context.test.ts",
    "test:permission": "tsx tests/compiler/permission.test.ts",
    "test:system-templates": "tsx tests/compiler/system_templates.test.ts",
    "test:python-bot-import": "tsx tests/compiler/python_bot_import.test.ts",
    "test:strict-validation": "tsx tests/compiler/strict_validation_pipeline.test.ts",
    "test:unified-pipeline": "tsx tests/compiler/unified_compile_pipeline.test.ts",
    "test:capability-engine": "tsx tests/compiler/capability_execution_engine.test.ts",
    "test:semantic-ai-pipeline": "node --test core/tests/semantic-ai-pipeline.test.mjs core/tests/deterministic-semantic-template.test.mjs",
    "test:runtime": "tsx tests/compiler/runtime.test.ts",
    "parser-core-blocks": "node scripts/core-blocks-check.mjs",
    "jammer:publish": "node scripts/publish-jammer-firmware.mjs",
    "flash:vendor": "mkdir -p public/flash/vendor && cp node_modules/esptool-js/bundle.js public/flash/vendor/esptool-js.bundle.js",
    "static:sync": "mkdir -p dist/esphome dist/flash && rsync -a public/esphome/ dist/esphome/ && rsync -a public/flash/ dist/flash/"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@xyflow/react": "^12.10.2",
    "bcryptjs": "^2.4.3",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "eventemitter3": "^5.0.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.1",
    "express-session": "^1.19.0",
    "framer-motion": "^12.40.0",
    "helmet": "^8.1.0",
    "immer": "^11.1.8",
    "jsonwebtoken": "^9.0.3",
    "lodash": "^4.18.1",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.13.1",
    "pm2": "^7.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "resend": "^6.12.2",
    "tsx": "^4.22.3",
    "uuid": "^14.0.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.21",
    "cross-env": "^7.0.3",
    "eslint": "^10.4.0",
    "esptool-js": "^0.6.0",
    "globals": "^17.6.0",
    "postcss": "^8.5.3",
    "prettier": "^3.8.3",
    "tailwindcss": "^3.4.17",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vite": "^5.2.0",
    "vitest": "^4.1.7"
  }
}
